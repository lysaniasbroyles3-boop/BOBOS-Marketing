function executeTrade(){

let symbol =
document.getElementById(
"tradeAsset"
).value;

let action =
document.getElementById(
"tradeAction"
).value;

let shares =
Number(
document.getElementById(
"tradeShares"
).value
);

if(!shares || shares<=0){

alert("Enter a valid number of shares.");

return;

}

let price =
assets[symbol].price;

let total =
price*shares;


if(action==="BUY"){

if(total>data.cash){

alert(
"Not enough simulated cash."
);

return;

}

data.cash -= total;

data.holdings[symbol] =
(data.holdings[symbol]||0)
+
shares;

}


else{

if(
(data.holdings[symbol]||0)
<
shares
){

alert(
"You don't own enough shares."
);

return;

}

data.cash += total;

data.holdings[symbol] -= shares;

}


data.transactions.unshift({

time:new Date().toLocaleString(),

action,

symbol,

shares,

price,

total

});


logSystem(
`${action} ${shares} ${symbol}`
);

save();

render();

}


