<script>

/* ==========================================
   BOB OS DATA
========================================== */

const assets = JSON.parse(
localStorage.getItem("bobAssets")
) || {

AAPL:{
name:"Apple",
price:190,
sector:"Technology",
history:[190]
},

MSFT:{
name:"Microsoft",
price:420,
sector:"Technology",
history:[420]
},

NVDA:{
name:"NVIDIA",
price:125,
sector:"Technology",
history:[125]
},

TSLA:{
name:"Tesla",
price:250,
sector:"Automotive",
history:[250]
},

KO:{
name:"Coca-Cola",
price:70,
sector:"Consumer",
history:[70]
},

DIS:{
name:"Disney",
price:95,
sector:"Entertainment",
history:[95]
}

};


let data = JSON.parse(
localStorage.getItem("bobData")
) || {

cash:10000,

holdings:{},

transactions:[],

goals:[],

startValue:10000,

notes:"",

user:""

};


/* ==========================================
   LOGIN
========================================== */

function login(){

let name =
document.getElementById(
"loginName"
).value.trim();

let password =
document.getElementById(
"loginPassword"
).value;

if(!name || !password){

document.getElementById(
"loginMessage"
).textContent =
"Please enter a name and password.";

return;

}

data.user = name;

localStorage.setItem(
"bobPassword",
password
);

save();

document.getElementById(
"loginScreen"
).classList.add("hidden");

document.getElementById(
"welcomeName"
).textContent =
name;

document.getElementById(
"systemUser"
).textContent =
name;

addBob(
"Hello " +
name +
"! I'm Bob. Type <b>help</b> to see what I can do."
);

logSystem(
"User logged into Bob OS."
);

}


/* ==========================================
   STORAGE
========================================== */

function save(){

localStorage.setItem(
"bobData",
JSON.stringify(data)
);

localStorage.setItem(
"bobAssets",
JSON.stringify(assets)
);

}


function logSystem(message){

let log =
document.getElementById(
"systemLog"
);

if(!log)return;

log.innerHTML =
`[${new Date().toLocaleTimeString()}] ${message}<br>`
+
log.innerHTML;

}


/* ==========================================
   NAVIGATION
========================================== */

function openPage(id,button){

document
.querySelectorAll(".page")
.forEach(
page =>
page.classList.remove("active")
);

document
.getElementById(id)
.classList.add("active");

document
.querySelectorAll("nav button")
.forEach(
b => b.classList.remove("active")
);

button.classList.add("active");

render();

}


/* ==========================================
   MONEY
========================================== */

function money(number){

return "$" +
Number(number).toLocaleString(
undefined,
{
minimumFractionDigits:2,
maximumFractionDigits:2
}
);

}


/* ==========================================
   PORTFOLIO
========================================== */

function portfolioValue(){

return Object
.entries(data.holdings)
.reduce(
(sum,[symbol,shares]) =>

sum +
assets[symbol].price *
shares,

0
);

}


/* ==========================================
   BOB CHAT
========================================== */

function addBob(message){

let chat =
document.getElementById("chat");

chat.innerHTML +=
`
<div class="msg bob">
<b>BOB:</b> ${message}
</div>
`;

chat.scrollTop =
chat.scrollHeight;

}


function addUser(message){

let chat =
document.getElementById("chat");

chat.innerHTML +=
`
<div class="msg user">
<b>YOU:</b> ${message}
</div>
`;

chat.scrollTop =
chat.scrollHeight;

}


function sendMessage(){

let input =
document.getElementById(
"chatInput"
);

let message =
input.value.trim();

if(!message)return;

addUser(message);

input.value="";

setTimeout(
() => bobThink(message),
300
);

}


function bobThink(message){

let text =
message.toLowerCase();


if(
text.includes("hello") ||
text.includes("hi") ||
text.includes("hey")
){

addBob(
"Hey! I'm Bob. 😎"
);

return;

}


if(text.includes("help")){

addBob(`

<b>BOB COMMANDS</b><br><br>

• joke<br>
• time<br>
• date<br>
• calculator<br>
• finance<br>
• market<br>
• trading<br>
• budget<br>
• goals<br>
• game<br>
• notes<br>
• hello<br>
• clear<br><br>

You can also ask me simple questions such as
"What can you do?"

`);

return;

}


if(text.includes("joke")){

let jokes=[

"Why did the computer get cold? It left its Windows open. 😂",

"Why was the JavaScript developer broke? Because he used up all his cache. 😎",

"What do computers eat? Microchips! 😂",

"Why did the programmer quit his job? He didn't get arrays. 😆"

];

addBob(
jokes[
Math.floor(
Math.random()*jokes.length
)
]
);

return;

}


if(text.includes("time")){

addBob(
"The current time is " +
new Date().toLocaleTimeString()
);

return;

}


if(text.includes("date")){

addBob(
"Today's date is " +
new Date().toLocaleDateString()
);

return;

}


if(text.includes("calculator")){

openPageByName("calculator");

addBob(
"I opened the calculator."
);

return;

}


if(text.includes("finance")){

openPageByName("finance");

addBob(
"Opening your financial dashboard."
);

return;

}


if(text.includes("market")){

openPageByName("market");

addBob(
"Opening the simulated market."
);

return;

}


if(
text.includes("trade") ||
text.includes("trading")
){

openPageByName("trade");

addBob(
"Opening paper trading."
);

return;

}


if(text.includes("budget")){

openPageByName("budget");

addBob(
"Opening the budget planner."
);

return;

}


if(text.includes("goal")){

openPageByName("goals");

addBob(
"Opening your financial goals."
);

return;

}


if(text.includes("game")){

openPageByName("games");

addBob(
"Let's play! I opened the games page."
);

return;

}


if(text.includes("note")){

openPageByName("notes");

addBob(
"Opening your notes."
);

return;

}


if(text.includes("what can you do")){

addBob(`

I can help you use Bob OS!

I have a calculator, games,
notes, budgeting tools, financial
planning tools, a simulated market,
and paper trading.

I can also remember information
locally on this device.

`);

return;

}


if(text.includes("clear")){

document.getElementById(
"chat"
).innerHTML="";

addBob("Chat cleared.");

return;

}


addBob(

"I don't have a built-in answer for that yet. " +
"Try <b>help</b> to see my commands."

);

}


function openPageByName(name){

let button =
[...document.querySelectorAll(
"nav button"
)]
.find(
b =>
b.textContent
.toLowerCase()
.includes(name)
);

if(button)
openPage(name,button);

}


/* ==========================================
   CALCULATOR
========================================== */

function calculate(){

let expression =
document.getElementById(
"calcInput"
).value;

try{

/*
 Only allow calculator characters.
 */

if(
!/^[0-9+\-*/().%\s]+$/
.test(expression)
){

throw new Error();

}

let result =
Function(
"return " +
expression
)();

document.getElementById(
"calcResult"
).textContent =
"Result: " + result;

}

catch{

document.getElementById(
"calcResult"
).textContent =
"Result: Invalid calculation";

}

}


/* ==========================================
   GAMES
========================================== */

let secret =
Math.floor(
Math.random()*100
)+1;


function newGame(){

secret =
Math.floor(
Math.random()*100
)+1;

document.getElementById(
"gameResult"
).textContent =
"New number generated!";

}


function guessNumber(){

let guess =
Number(
document.getElementById(
"guess"
).value
);

if(
!guess ||
guess<1 ||
guess>100
){

return;

}

if(guess===secret){

document.getElementById(
"gameResult"
).textContent =
"🎉 Correct! You got it!";

}

else if(guess<secret){

document.getElementById(
"gameResult"
).textContent =
"Too low!";

}

else{

document.getElementById(
"gameResult"
).textContent =
"Too high!";

}

}


/* ==========================================
   FINANCE RENDER
========================================== */

function renderFinance(){

let portfolio =
portfolioValue();

let worth =
data.cash +
portfolio;

let pnl =
worth -
data.startValue;


document.getElementById(
"homeCash"
).textContent =
money(data.cash);

document.getElementById(
"homePortfolio"
).textContent =
money(portfolio);

document.getElementById(
"homeWorth"
).textContent =
money(worth);

document.getElementById(
"homePnl"
).textContent =
money(pnl);


document.getElementById(
"financeCash"
).textContent =
money(data.cash);

document.getElementById(
"financePortfolio"
).textContent =
money(portfolio);

document.getElementById(
"financeWorth"
).textContent =
money(worth);

document.getElementById(
"financePnl"
).textContent =
money(pnl);


let positions =
Object
.entries(data.holdings)
.filter(
([s,q])=>q>0
);


document.getElementById(
"holdings"
).innerHTML =

positions.length

?

`
<table>

<tr>
<th>Asset</th>
<th>Shares</th>
<th>Price</th>
<th>Value</th>
</tr>

${
positions.map(
([symbol,shares]) =>

`
<tr>

<td>${symbol}</td>

<td>${shares.toFixed(2)}</td>

<td>${money(
assets[symbol].price
)}</td>

<td>${money(
shares *
assets[symbol].price
)}</td>

</tr>
`
).join("")
}

</table>
`

:

"No investments yet.";

}


/* ==========================================
   MARKET
========================================== */

function renderMarket(){

document.getElementById(
"marketTable"
).innerHTML =

`
<table>

<tr>
<th>Ticker</th>
<th>Name</th>
<th>Price</th>
<th>Change</th>
<th>Sector</th>
</tr>

${
Object.entries(assets)
.map(
([symbol,a]) => {

let old =
a.history.at(-2)
||
a.price;

let change =
a.price-old;

return`

<tr>

<td><b>${symbol}</b></td>

<td>${a.name}</td>

<td>${money(a.price)}</td>

<td class="${
change>=0
?
"green"
:
"red"
}">

${change>=0?"+":""}
